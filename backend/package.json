{
  "name": "pennywise-api",
  "version": "1.0.0",
  "description": "REST API for the PennyWise expense tracker (Node.js + Supabase)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/e2e/**/*.test.js\""
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.2"
  }
}
